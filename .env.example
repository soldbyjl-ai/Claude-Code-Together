# Paragon MLS credentials
PARAGON_USERNAME=your_paragon_username@example.com
PARAGON_PASSWORD=your_paragon_password

# BC Assessment (no login required, but rate-limit delay in seconds)
BCASSESSMENT_DELAY=2.5

# Paths
EXCEL_FILE=1VBN - Brentwood Park.xlsx

# Grocery Flyer Scraper
# Set to true to run flyer scrapers headlessly (unattended/scheduled).
# Paragon and BC Assessment scrapers are NOT affected by this — they remain headless=False.
FLYER_HEADLESS=true
